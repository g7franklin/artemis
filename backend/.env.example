# Copy to .env and fill in real values.

XAI_API_KEY=
# Text model for memory extraction (not voice)
XAI_CHAT_MODEL=grok-2-latest
OPENAI_API_KEY=
PINECONE_API_KEY=
PINECONE_INDEX_NAME=artemis-memory
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Duffel (flights) — access token from https://duffel.com (test or live)
DUFFEL_ACCESS_TOKEN=
# Optional: default https://api.duffel.com
# DUFFEL_API_BASE_URL=https://api.duffel.com
# Optional: supplier wait cap in ms (see Duffel offer_requests docs)
# DUFFEL_SUPPLIER_TIMEOUT_MS=20000
NOTION_API_KEY=
PORT=8080
NODE_ENV=development

# WebSocket keepalive (ms). Set 0 to disable. Helps proxies / Cloud Run.
WS_PING_INTERVAL_MS=30000

# Express trust proxy hops (Cloud Run / load balancers). Set 0 to disable.
TRUST_PROXY_HOPS=1
